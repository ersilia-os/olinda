# Eosvc — anchored to the repo root, so it cannot swallow the olinda/data/ package
/data/
.eosvc/
access.json

# macOS
.DS_Store

# Scratch data / run artifacts at repo root
/train.h5
/val.h5
/*.png
/best_params.json

# Findings report written by the repository-auditing skill. Regenerated on demand, and it is a
# working note about the repo rather than part of it.
/AUDIT.md

# Distilled models and the folders that build them. `fit -m runs/foo.onnx` writes runs/foo.onnx and
# builds in runs/foo/ — none of it belongs in git (CLAUDE.md: no model artefacts or large binaries).
*.onnx
/runs/
/test_*/

# Example OUTPUTS only — not the directory. example/run.sh and run_stepwise.sh are the worked examples
# the README points at, so they ship; the results they write are models and reports. Their inputs live in
# data/example/ (eosvc).
example/results/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
dev/
artifacts/
wheels/
*.egg-info
.ruff_cache
.pytest_cache/
# Virtual environments
.venv

# ZairaChem distillation experiment (scratch: scripts, inputs, outputs, 174MB CLAMP encoder)
zairachem_test/

# The WebAssembly featurizer (olinda/featurizer/rdkit_qmfp.wasm) is committed, so a clone or a
# `pip install git+...` can featurize; only the RDKit build tree under wasm/ stays out of git.
/wasm/.cache/

# The web page (site/) pulls onnxruntime-web from npm and copies the featurizer from the package; neither
# copy is committed. CI assembles both before deploying.
/site/node_modules/
/site/ort/
/site/rdkit_qmfp.wasm
/site/package-lock.json
